# Environment — ignora todo .env.* (local, docker, production...) exceto os templates
.env
.env.*
!.env.example
!.env.docker.example
*.env

# Dependencies
node_modules/
.pnp
.pnp.js
.venv/
__pycache__/
*.pyc
*.egg-info/

# Build
.next/
out/
dist/
build/

# Test coverage (Vitest output)
coverage/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Supabase
supabase/.temp/
supabase/.branches/

# Next.js
next-env.d.ts
.next/
tsconfig.tsbuildinfo

# Runtime do start.ps1 (PID, logs)
.run/

# Manuais originais do cliente (prints expõem IP interno do DAEE — tratar como sensível até confirmação)
docs/manuais-cliente/

# Relatórios pessoais do consultor (fora de escopo do repo do cliente)
docs/relatorios/

# Data dumps / planilhas originais (governo — não subir em repo público)
# comentar se for repo privado e quiser versionar a planilha base
# *.csv
# *.xlsx

# Snapshots gerados por scripts de manutenção (limpar_fim_operacao_ativos.py, etc.)
# Contêm dados de produção — manter sempre fora do git.
data/backup_*.csv
# Dumps logicos do banco (scripts/backup_banco.py) — dado de producao, nunca no git
data/backups/

.vercel

# Settings locais do harness Claude Code (per-repo overrides)
.claude/settings.local.json

# Locks internos do harness (ScheduleWakeup, /loop, etc) — runtime-only, nunca commitar
.claude/*.lock

# Capacitor / Android
# Pasta nativa regenerada por `npx cap add android`; versionamos só o
# capacitor.config.ts e o webDir (android-www). APK e artefatos em /dist.
/dist/
/android/

# Planilhas oficiais ANA (dado de governo, fora do git)
data/inventario-ana/

# Output do Playwright MCP (screenshots/logs de inspecao, runtime)
.playwright-mcp/

# Scratch do subagent-driven-development (ledger de progresso, runtime)
.superpowers/
