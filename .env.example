# Template de variáveis — copiar para .env.local e preencher.
# Nunca commitar .env.local no git.

# -------------------------------------------------------------------
# Dashboard (Next.js)
# -------------------------------------------------------------------
# Connection string direta do PostgreSQL — usada pelas API Routes via postgres.js.
#
# IMPORTANTE: Supabase pooler tem 2 portas.
#   5432 (Session)     → USAR ESTA no Next.js (postgres.js 3.x é incompatível
#                        com Transaction mode por bug conhecido).
#   6543 (Transaction) → só pra clientes que mandam queries curtas e unitárias
#                        (curl, psql, scripts sem prepared statements).
#
# Exemplo: postgresql://postgres.PROJETO:SENHA@aws-X.pooler.supabase.com:5432/postgres
# Role recomendada: "app" (apenas CRUD nas tabelas do MVP, sem DDL, sem UPDATE em acesso_ficha).
DATABASE_URL=

# URL pública do app — usada em canonical tags e chamadas internas (default: http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -------------------------------------------------------------------
# SQL Server do órgão (Dbfch) — cadastro de posto lido AO VIVO (ADR-0023)
# -------------------------------------------------------------------
# Preenchidas estas cinco, o CADASTRO DE POSTO passa a ser lido diretamente do
# banco do órgão, sem cópia, sem banco intermediário e sem cache. Ausentes, o
# sistema cai no adaptador PostgreSQL, cuja tabela `postos` está VAZIA: a busca
# não retorna nada, e é esse o sintoma de esquecer estas variáveis.
#
# O acesso concedido é SOMENTE LEITURA. A aplicação recusa qualquer verbo de
# escrita antes de a consulta sair do processo, e a edição de cadastro responde
# HTTP 501 até existir a API de escrita do órgão.
#
# Alcance: exige a rede interna do órgão (VPN em desenvolvimento). Quando ela
# está fora, o sintoma é TIMEOUT, e não erro de credencial.
SQLSERVER_HOST=
SQLSERVER_PORTA=1433
SQLSERVER_USUARIO=
SQLSERVER_SENHA=
SQLSERVER_BANCO=
# Criptografia do transporte TDS. O padrão é "nao" porque é o que funciona
# contra a instância do órgão hoje: rede interna, sem certificado emitido por
# autoridade que o Node reconheça. Ligar depende de o órgão publicar o
# certificado no contêiner.
# SQLSERVER_ENCRYPT=nao
# SQLSERVER_TRUST_CERT=sim

# -------------------------------------------------------------------
# Script de importação (ops/importer/import_csv.py)
# -------------------------------------------------------------------
# Mesma connection string, mas com role de serviço (DDL não, DML sim em postos e import_log).
DATABASE_URL_IMPORTER=

# Caminho do CSV oficial (pode ser absoluto ou relativo à raiz do projeto)
IMPORTER_CSV_PATH=./data/Postos_PLU_FLU_PIEZO_CIAS_BAT_MUNIC_UGRHI_SUB_OTTO-18-03-26a-csv.csv

# -------------------------------------------------------------------
# Worker de indexação (ops/indexer/)
# -------------------------------------------------------------------
# Connection string com role restrita: leitura em postos, escrita em arquivos_indexados / arquivos_orfaos / indexacao_log.
DATABASE_URL_INDEXER=

# Caminho raiz que o worker varre. Em Windows, pode ser drive mapeado.
# DAEE/SPAguas:  Y:\000 Documentos de Campo
# Detalhes dos modelos de arquivo (Modelo A = por prefixo / Modelo B = REPOSITORIO numerado):
# ver docs/repositorio-cliente.md §3
INDEXER_ROOT_PATH=

# -------------------------------------------------------------------
# Supabase (somente se for usar o dashboard do Supabase para DBA;
# o app não precisa dessas variáveis em runtime)
# -------------------------------------------------------------------
# SUPABASE_PROJECT_REF=
# SUPABASE_ACCESS_TOKEN=

# -------------------------------------------------------------------
# Allowlist de autenticação (Supabase Auth)
# -------------------------------------------------------------------
# Domínios institucionais permitidos pro login (CSV).
# Default no código: sp.gov.br,daee.sp.gov.br,rafaeldamasceno.dev
# Pra MODO DEMO (avaliadores externos sem domínio institucional ainda),
# setar AUTH_ALLOWED_EMAIL_DOMAINS=* libera qualquer domínio.
# QUANDO o sistema for entregue em produção, restaurar a lista oficial.
# AUTH_ALLOWED_EMAIL_DOMAINS=*
#
# Emails individuais permitidos fora dos domínios acima (CSV).
# AUTH_EXTRA_ALLOWED_EMAILS=consultor@empresa.com,outro@dominio.com

# -------------------------------------------------------------------
# Dev-only — bypass de autenticação em desenvolvimento local.
# Guardas duplas: só funciona com NODE_ENV=development + variável preenchida.
# Em produção (Vercel/Docker) é ignorado mesmo se acidentalmente preenchido.
# -------------------------------------------------------------------
# DEV_BYPASS_AUTH_EMAIL=seu@email.dev
# DEV_BYPASS_AUTH_USER_ID=uuid-do-usuario-real-supabase   # opcional
