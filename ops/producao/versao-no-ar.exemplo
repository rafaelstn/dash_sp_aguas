# =============================================================================
# MODELO do arquivo que diz QUAL VERSAO esta no ar.
# =============================================================================
# Destino no servidor:  /opt/spaguas-dmo/.env
# (o mesmo diretorio onde fica o docker-compose.prod.yml)
#
# POR QUE ESTE ARQUIVO EXISTE SEPARADO DO OUTRO:
# o Compose so resolve `${...}` de dentro do docker-compose.prod.yml a partir do
# `.env` do diretorio do projeto e do ambiente do shell. Variavel declarada em
# `env_file` chega ao CONTAINER, e nao ao Compose: tentando com um arquivo so, o
# erro que sai e "required variable IMAGEM_TAG is missing a value" (medido em
# 27/08/2026). Como a tag da imagem e a porta sao usadas para MONTAR o servico,
# elas tem que morar aqui.
#
# O ganho de tabela dessa separacao: o arquivo que muda a cada entrega e a cada
# rollback e justamente o que NAO tem segredo nenhum.
#
# Permissao: 0644 root:root serve. Nao ha segredo aqui.
# =============================================================================

# Tag de commit da imagem carregada por `docker load`. SEMPRE sha-xxxxxxx.
# `latest` e proibido: esta linha e o que torna o rollback possivel.
#
# Entrega:  trocar por sha-<novo>       + docker compose up -d
# Rollback: trocar por sha-<anterior>   + docker compose up -d --force-recreate
IMAGEM_TAG=

# Nome da imagem. So muda se o repositorio de imagem mudar.
IMAGEM_NOME=spaguas/dashboard

# Porta em 127.0.0.1 onde o Nginx do orgao faz proxy_pass. Precisa bater com o
# `proxy_pass http://127.0.0.1:3000` do bloco de Nginx.
APP_PORT=3000
