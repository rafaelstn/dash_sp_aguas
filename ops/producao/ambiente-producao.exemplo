# =============================================================================
# MODELO do ambiente da APLICACAO em producao.
# =============================================================================
# Destino no servidor:  /etc/spaguas-dmo/app.env
#
# O nome deste modelo nao termina em .env de proposito, para que o arquivo REAL
# continue coberto pelo .gitignore sem excecao nenhuma. Excecao em regra de
# segredo e o que deixa segredo escapar.
#
# Este modelo NAO tem nenhum valor sensivel preenchido, tambem de proposito:
# modelo com valor de aparencia legitima e o que sobe para producao quando
# alguem copia e esquece de preencher.
#
# Preparar o destino no servidor:
#   sudo install -d -m 0750 -o root -g docker /etc/spaguas-dmo
#   sudo install -m 0640 -o root -g docker /dev/null /etc/spaguas-dmo/app.env
#   sudo stat -c "%a %U:%G %n" /etc/spaguas-dmo/app.env  # espera: 640 root:docker
#
# ATENCAO: quem tem acesso ao Portainer LE estas variaveis na aba de ambiente do
# container, inclusive a string de conexao do banco. Permissao de arquivo
# protege o disco, nao o painel. Ver o pedido ao orgao no runbook.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. O que NAO vai neste arquivo
# -----------------------------------------------------------------------------
# IMAGEM_TAG, IMAGEM_NOME e APP_PORT ficam em /opt/spaguas-dmo/.env, porque sao
# usadas pelo Compose para MONTAR o servico, e o Compose nao le env_file para
# isso. Posta-las aqui produz "required variable IMAGEM_TAG is missing a value"
# (medido em 27/08/2026). Modelo: ops/producao/versao-no-ar.exemplo
#
# POSTGRES_DB, POSTGRES_USER e POSTGRES_PASSWORD ficam em
# /etc/spaguas-dmo/db.env, lido pelos servicos do BANCO. A aplicacao nao precisa
# delas soltas: precisa da DATABASE_URL montada, abaixo.

# -----------------------------------------------------------------------------
# 2. Banco de dados
#    Fail-fast: sem esta variavel a aplicacao RECUSA subir em producao
#    (src/infrastructure/config/env.ts, linhas 50-54). E isso esta certo.
# -----------------------------------------------------------------------------
# Decisao do Rafael em 27/08/2026: o PostgreSQL da aplicacao roda como CONTAINER
# nesta mesma maquina, definido no docker-compose.prod.yml. O endereco abaixo e
# o NOME DO SERVICO na rede interna do Docker, e nao um endereco de rede do
# orgao: quem resolve o nome db e o DNS interno do Compose.
#
# O banco nasce VAZIO e as migrations sobem pelo servico migrate. Nao ha
# importacao nem copia de dado: posto e medicao passam a vir do SQL Server do
# orgao por leitura ao vivo (ADR-0023), e este banco guarda so o que e so nosso.
#
# A senha aqui e a MESMA de POSTGRES_PASSWORD em db.env. Conferir sem imprimir
# valor nenhum: ver o rodape de ops/producao/banco.exemplo.
#
# Formato:  postgresql://<usuario>:<senha>@db:5432/<banco>
DATABASE_URL=

# -----------------------------------------------------------------------------
# 3. Identidade e autenticacao
# -----------------------------------------------------------------------------
# O SUPABASE SAIU. Ordem do Rafael em 27/08/2026: "esquece o supabase". Pelo
# ADR-0023, a autenticacao passa a ser contra o UsuariosIdentity do orgao, com o
# auth.users local recebendo o mesmo identificador.
#
# PENDENCIA DE APLICACAO, e ela impede a subida ate ser resolvida: o env.ts
# ainda EXIGE NEXT_PUBLIC_SUPABASE_URL e NEXT_PUBLIC_SUPABASE_ANON_KEY em
# producao (linhas 55-59), e o middleware ainda chama o Supabase a cada
# requisicao (linhas 125-126). Enquanto essas linhas existirem, a aplicacao ou
# recusa subir, ou sobe e trava toda navegacao numa chamada de rede que nunca
# completa. A correcao e de codigo, esta apontada na secao 9.2 do runbook, e NAO
# se contorna por variavel de ambiente: as duas sao gravadas no pacote em tempo
# de build, entao trocar de identidade exige RECONSTRUIR a imagem.
#
# As variaveis da nova camada de identidade entram aqui quando forem definidas.

# Dominios institucionais autorizados, separados por virgula. O coringa asterisco
# e RECUSADO em producao pelo env.ts (linhas 67-73), porque libera autocadastro
# para qualquer dominio.
AUTH_ALLOWED_EMAIL_DOMAINS=sp.gov.br,daee.sp.gov.br
# Enderecos individuais fora da lista de dominios (consultor, por exemplo), CSV.
AUTH_EXTRA_ALLOWED_EMAILS=

# -----------------------------------------------------------------------------
# 4. Rotas de rotina (/api/cron/*)
# -----------------------------------------------------------------------------
# Segredo do cabecalho que autoriza as rotinas (comparado por tempo constante).
# Gerar NO SERVIDOR, nunca aqui:  openssl rand -base64 32
#
# Sem internet nao existe agendador externo chamando estas rotas. Quem passa a
# chamar precisa ser decidido (tarefa agendada no host com curl em 127.0.0.1, ou
# agendador do orgao). Sem chamador, a anonimizacao da trilha (retencao LGPD)
# NAO acontece, em silencio.
CRON_SECRET=

# Dias de retencao antes de anonimizar a trilha de auditoria. Vazio usa o
# default do codigo. Prazo a confirmar com o orgao (art. 16, I da LGPD).
TRILHA_RETENCAO_DIAS=

# -----------------------------------------------------------------------------
# 5. Endereco publico (ATENCAO: tambem e argumento de BUILD)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_APP_URL e embutida no pacote do navegador em tempo de BUILD.
# Definir so aqui NAO muda o que o navegador recebe: o valor real tem que ir no
# --build-arg na hora de construir a imagem (ver runbook). Fica no arquivo
# porque o servidor tambem a le em tempo de execucao.
NEXT_PUBLIC_APP_URL=https://dmo.spaguas.sp.gov.br

# -----------------------------------------------------------------------------
# 6. Observabilidade
# -----------------------------------------------------------------------------
# Coletor de log externo por HTTP. DEIXAR VAZIO neste servidor: nao ha saida
# para a internet, e cada tentativa custa um tempo de espera de 2 s por evento.
# O log fica no json-file do Docker, com a rotacao definida no compose.
LOG_DRAIN_URL=
LOG_DRAIN_TOKEN=
LOG_DRAIN_MIN_SEVERITY=

# -----------------------------------------------------------------------------
# 7. NUNCA definir em producao
# -----------------------------------------------------------------------------
# Listadas aqui para que apareca em revisao se alguem as acrescentar:
#
#   DEV_BYPASS_AUTH_EMAIL      pula a autenticacao inteira
#   DEV_BYPASS_AUTH_USER_ID    idem
#   DEV_PAPEL_USUARIO          forca o papel do usuario (RBAC, ADR-0022)
#   DEV_APROVADOR_USUARIO_ID   forca o aprovador da triagem
#   SPAGUAS_PWA_FORCE_ENABLE   so existe para depuracao local do PWA
#
# Conferir no servidor antes de subir:
#   sudo grep -cE "^(DEV_|SPAGUAS_PWA_FORCE_ENABLE)" /etc/spaguas-dmo/app.env
#   # espera: 0
