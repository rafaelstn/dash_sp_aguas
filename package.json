{
  "name": "spaguas-ficha-tecnica",
  "version": "0.1.0",
  "private": true,
  "description": "Dashboard de consulta da rede de postos hidrológicos SPÁguas — Governo do Estado de São Paulo",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pwa:icons": "node scripts/gerar-icones-placeholder.mjs",
    "pwa:build": "next build",
    "pwa:audit": "npx --yes lighthouse http://localhost:3000/app --only-categories=pwa,accessibility,performance,best-practices --chrome-flags=--headless --output=html --output-path=./docs/relatorios/lighthouse-pwa.html"
  },
  "dependencies": {
    "@serwist/next": "^9.5.11",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.104.1",
    "lucide-react": "^1.14.0",
    "next": "^15.5.15",
    "postgres": "3.4.5",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "serwist": "^9.5.11",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "10.4.20",
    "eslint": "9.18.0",
    "eslint-config-next": "^15.5.15",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "postcss": "8.5.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
