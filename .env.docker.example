# =============================================================================
# Template do ambiente conteinerizado — copiar para .env.docker e preencher.
# NUNCA versionar o .env.docker (já coberto pelo .gitignore).
# Lido automaticamente pelo docker compose (arquivo .env.docker na raiz).
# =============================================================================

# -----------------------------------------------------------------------------
# Banco (serviço db) — PostgreSQL + PostGIS
# -----------------------------------------------------------------------------
POSTGRES_DB=spaguas
POSTGRES_USER=spaguas
# Obrigatório. Gere um valor forte: openssl rand -base64 24
POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# App (serviço app) — dashboard Next.js
# -----------------------------------------------------------------------------
# Porta publicada no host (default 3000).
APP_PORT=3000
# URL pública do app (embutida no bundle em build — rebuildar se mudar).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Domínios institucionais permitidos no login (CSV). Em produção, lista oficial.
AUTH_ALLOWED_EMAIL_DOMAINS=sp.gov.br,daee.sp.gov.br

# Identidade (Supabase Auth — fase de transição até a auth definitiva no PRODESP).
# Embutidas no bundle em build. Deixe em branco para avaliar em modo demo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Segredo do endpoint de cron/manutenção (se usado). Gere com openssl rand -hex 32.
CRON_SECRET=

# -----------------------------------------------------------------------------
# Workers batch (profile "ops") — caminhos no HOST montados nos containers
# -----------------------------------------------------------------------------
# Diretório do host que contém o CSV oficial (montado como /data:ro no importer).
# O importer espera o arquivo em /data/postos.csv.
IMPORTER_CSV_PATH=./data
# Raiz do compartilhamento de rede varrida pelo indexer (montada /repositorio:ro).
# No PRODESP, o mount do share institucional. Em dev, um diretório local.
INDEXER_ROOT_PATH=./data
